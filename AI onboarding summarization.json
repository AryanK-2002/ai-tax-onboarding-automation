    {
      "parameters": {
        "jsCode": "const fields = $json.body.data.fields;\n\nfunction getField(label) {\n  const field = fields.find(f => f.label === label);\n\n  if (!field) return \"\";\n\n  // Handle multiple choice fields\n  if (field.options && field.value) {\n\n    const selectedId = field.value[0];\n\n    const option = field.options.find(\n      o => o.id === selectedId\n    );\n\n    return option ? option.text : \"\";\n  }\n\n  return field.value;\n}\n\nreturn [{\n  name: getField(\"Full Name\"),\n  email: getField(\"Email\"),\n  income_type: getField(\"Income Type\"),\n  annual_income: getField(\"Annual Income(in INR)\"),\n  form16: getField(\"Form16 Uploaded?\"),\n  rent: getField(\"Rent Receipt Uploaded?\"),\n  investment: getField(\"Investment Proof Uploaded?\")\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "a9eb4ccc-5528-492a-b355-a35b55941da2",
      "name": "Extract Form Data"
    },
    {
      "parameters": {
        "jsCode": "let missing = [];\n\nif ($json.form16 !== \"Yes\")\n  missing.push(\"Form16\");\n\nif ($json.rent !== \"Yes\")\n  missing.push(\"Rent Receipt\");\n\nif ($json.investment !== \"Yes\")\n  missing.push(\"Investment Proof\");\n\n$json.missing_docs = missing.join(\", \");\n\nreturn $input.item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "4d96bb22-3309-4f01-81a8-7a94ce8b111e",
      "name": "Missing Docs Check"
    },
    {
      "parameters": {
        "jsCode": "let complexity = \"Simple\";\n\nif (\n  $json.income_type === \"Business\" ||\n  $json.income_type === \"Multiple Income Sources\"\n) {\n  complexity = \"Complex\";\n}\n\nif (\n  complexity === \"Simple\" &&\n  $json.missing_docs !== \"\"\n) {\n  complexity = \"Needs Review\";\n}\n\n$json.complexity = complexity;\n\nreturn $input.item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "80fa1390-926c-4d11-8170-1190b738a92a",
      "name": "Complexity Classifier"
    },
    {
      "parameters": {
        "jsCode": "const missingDocs =\n  !$json.missing_docs ||\n  $json.missing_docs.trim() === \"\"\n    ? \"None\"\n    : $json.missing_docs;\n\nconst summary = `\nCLIENT SUMMARY\n\nClient Name: ${$json.name}\n\nEmail: ${$json.email}\n\nIncome Type: ${$json.income_type}\n\nAnnual Income: ₹${Number($json.annual_income).toLocaleString('en-IN')}\n\nComplexity: ${$json.complexity}\n\nMissing Documents:\n${missingDocs}\n\nSuggested Action:\n${\n  $json.complexity === \"Complex\"\n    ? \"Route to Senior Advisor\"\n    : missingDocs !== \"None\"\n    ? \"Request Missing Documents\"\n    : \"Proceed with Standard Processing\"\n}\n\nAdvisor Notes:\n${\n  missingDocs !== \"None\"\n    ? \"Missing documents require follow-up.\"\n    : \"All required documents are available.\"\n}\n`;\n\n$json.missing_docs = missingDocs;\n$json.advisor_summary = summary;\n\nreturn $input.item;"
      },
