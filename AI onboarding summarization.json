        "message": "=<h2> {{\n$json[\"Complexity\"] === \"Complex\"\n? \"🚨 Client Tax Case\"\n: $json[\"Complexity\"] === \"Needs Review\"\n? \"⚠️ Client Tax Case\"\n: \"✅ Client Tax Case\"\n}}</h2>\n\n<h1>Client Name: {{$json[\"Name\"]}}</h1>\n\n<hr>\n\n<p><u><strong>Client Details:</strong></u></p>\n\n<ul>\n<li>Email: {{$json[\"Email\"]}}</li>\n<li>Income Type: {{$json[\"Income Type\"]}}</li>\n<li>Annual Income: ₹{{ Number($json[\"Annual Income\"]).toLocaleString('en-IN') }}</li>\n</ul>\n\n<p><u><strong>Case Assessment:</strong></u></p>\n\n<ul>\n<li>Complexity: {{$json[\"Complexity\"]}}</li>\n<li>Missing Documents: {{$json[\"Missing Docs\"]}}</li>\n<li>Advisor Queue: {{$json[\"Advisor Queue\"]}}</li>\n</ul>\n\n<p><u><strong>Next Actions:</strong></u></p>\n\n<ul>\n<li>Review submitted information</li>\n<li>Collect pending documents if any</li>\n<li>Schedule advisor consultation</li>\n</ul>",
